---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LoginDialog from "../components/LoginDialog.astro";
import { LOGIN_WINDOW } from "../config";

interface Props {
  title: string;
  description: string;
  path: string; // chemin canonique, ex. "/" ou "/confidentialite/"
  jsonLd?: object;
  noindex?: boolean;
}

const { title, description, path, jsonLd, noindex = false } = Astro.props;
const site = "https://plandesign.fr";
const canonical = new URL(path, site).href;
const ogImage = `${site}/og.png`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f6f0e5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1e1915" media="(prefers-color-scheme: dark)" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preload" href="/fonts/outfit-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin-400.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="PlanDesign" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="PlanDesign : de la photo de la pièce au plan, puis aux rendus." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}{/* B1d-b : sur la même ligne, pour que la sortie sans l'option reste identique octet pour octet. */}{LOGIN_WINDOW && <link rel="stylesheet" href="/login.css" />}{LOGIN_WINDOW && <script src="/login.js" defer></script>}
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />{LOGIN_WINDOW && <LoginDialog />}
  </body>
</html>
