---
import Logo from "./Logo.astro";
import SoonButton from "./SoonButton.astro";
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="PlanDesign, accueil">
      <Logo />
      <span>PlanDesign</span>
    </a>
    <nav class="nav" aria-label="Sections">
      <a href="/#fonctionnalites">Fonctionnalités</a>
      <a href="/#comment-ca-marche">Comment ça marche</a>
      <a href="/#vos-donnees">Vos données</a>
    </nav>
    <div class="header-actions">
      <SoonButton label="Ouvrir mon espace" variant="outline" />
      <SoonButton label="Se lancer" />
    </div>
  </div>
</header>
