---
// B1d-b : fenêtre « Se connecter » (rendue seulement avec PUBLIC_LOGIN_WINDOW=1). Deux temps :
// l'adresse, puis le code reçu par e-mail. Le comportement est dans login/login.js (fichier
// externe : pas de script en ligne, CSP stricte), qui appelle l'API de l'application.
// KAN-104 : la seconde voie, le mot de passe, cachée tant que /api/health de l'app ne dit pas
// `password_login` (fermé, ou pas de réponse : rien n'en paraît). Le mot de passe ne se tape
// pas ici : le lien ouvre la page de connexion de l'application sur cette étape (conception
// L1 : aucune route du mot de passe n'est ouverte au site, pas de CORS à cookies en plus).
import { APP_ORIGIN } from "../config";
---
<dialog id="connexion" class="login-dialog" aria-labelledby="connexion-titre" data-app-origin={APP_ORIGIN}>
  <form method="dialog" class="login-close-form">
    <button type="submit" class="login-close" aria-label="Fermer">×</button>
  </form>
  <h2 id="connexion-titre">Se connecter à PlanDesign</h2>
  <form class="login-step" data-step="email">
    <p class="login-text login-beta" data-signup-invite hidden>PlanDesign est en bêta, sur invitation. Déjà inscrit ou invité ? Connectez-vous.</p>
    <p class="login-text"><span data-password-off>Sans mot de passe.</span><span data-password hidden>Avec un code reçu par e-mail, ou votre mot de passe.</span></p>
    <label class="mono" for="connexion-email">Adresse e-mail</label>
    <input id="connexion-email" name="email" type="email" autocomplete="email" required maxlength="320" />
    <p class="login-error" role="alert" hidden></p>
    <button type="submit" class="btn btn-primary btn-block">Recevoir un code</button>
    <a class="login-back" data-password hidden href={`${APP_ORIGIN}/#/mot-de-passe`}>Se connecter avec un mot de passe</a>
  </form>
  <form class="login-step" data-step="code" hidden>
    <p class="login-text" role="status"><span data-signup-open>Si cette adresse peut se connecter, un code vient de partir.</span><span data-signup-invite hidden>Si cette adresse a un compte ou une invitation, un code vient de partir.</span> Il expire dans 15 minutes.</p>
    <p class="login-text">Pas reçu ? Regardez dans vos courriers indésirables.</p>
    <label class="mono" for="connexion-code">Code à 6 chiffres</label>
    <input id="connexion-code" name="code" class="login-code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,8}" maxlength="8" required />
    <p class="login-error" role="alert" hidden></p>
    <button type="submit" class="btn btn-primary btn-block">Se connecter</button>
    <button type="button" class="login-back" data-go="email">Changer d'adresse ou recevoir un nouveau code</button>
  </form>
  <p class="login-mention">
    <span data-password-off>Un code vous est envoyé par e-mail.</span><span data-password hidden>Un code ou votre mot de passe.</span> Vos données restent en France. <a href="/confidentialite/">Confidentialité</a>
  </p>
</dialog>
