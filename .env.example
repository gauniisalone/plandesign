# ============================================================
# Copier vers .env (jamais commité). Toutes les valeurs ont un défaut sûr.
# ============================================================

# Dossier des projets utilisateur (images, scènes, runs). Relatif à la racine du dépôt.
OPENPLAN_DATA_DIR=./data

# Binaire Blender (optionnel : sans lui, GLB via trimesh, pas de rendu ni de .blend)
OPENPLAN_BLENDER_BIN=blender

# Périphérique de calcul pour les modèles locaux : auto (défaut : cuda dès qu'un GPU est vu,
# sinon cpu) | cuda | cpu. Le périphérique retenu est affiché au démarrage et dans l'interface.
# Attention : cpu = plusieurs minutes par image d'inspiration.
OPENPLAN_DEVICE=auto

# Secondes sans calcul avant de libérer la carte graphique (Stable Diffusion, ControlNet,
# IP-Adapter, profondeur, détecteur d'ouvertures) ; rechargés au calcul suivant. 0 : jamais.
OPENPLAN_GPU_IDLE_S=600

# Dossier des poids de modèles locaux (jamais commité). Remplissage explicite :
#   make setup-neural ; uv run openplan models pull depth_anything_v2_metric_indoor_small@1.0
OPENPLAN_MODELS_DIR=./models/weights

# L'API n'écoute que sur la boucle locale par défaut.
OPENPLAN_HOST=127.0.0.1
OPENPLAN_PORT=8000

# Aucun téléchargement implicite de poids : les modèles se récupèrent explicitement.
HF_HUB_OFFLINE=1

# ------------------------------------------------------------
# Assistant IA (optionnel). Sans OPENPLAN_AI_BASE_URL et OPENPLAN_AI_MODEL : aucun modèle.
# Un hôte distant n'est appelé que si le projet a privacy.allow_remote_models ET
# privacy.remote_consent (confirmation dans l'interface). Chaque appel est journalisé dans
# <projet>/network_log.jsonl (destination, octets, durée), jamais son contenu.
# ------------------------------------------------------------
# Serveur local (Ollama, llama.cpp, vLLM) : pas distant, pas de consentement requis.
# OPENPLAN_AI_BASE_URL=http://127.0.0.1:11434/v1
# OPENPLAN_AI_MODEL=llava
# OpenAI :
# OPENPLAN_AI_BASE_URL=https://api.openai.com/v1
# OPENPLAN_AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# Gemini (point d'entrée compatible OpenAI) :
# OPENPLAN_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENPLAN_AI_MODEL=gemini-3.5-flash-lite   (les gemini-2.x sont retirés du service ; lister : GET <base_url>/models)
# GEMINI_API_KEY=
# La clé peut aussi être donnée dans OPENPLAN_AI_API_KEY (prioritaire).
# Jetons nommés exigés dès que l'API écoute hors de 127.0.0.1 (`serve --host` refuse sans) :
# `uv run openplan token augus` en génère un ; le nom devient l'acteur user:<nom> de l'historique.
# Plusieurs personnes : virgules. Révoquer = retirer l'entrée et relancer. Journal des accès
# (sans jeton ni contenu) dans <OPENPLAN_DATA_DIR>/access.jsonl quand l'API est exposée.
# OPENPLAN_API_TOKENS=augus:…,marie:…
# Ancien jeton unique, encore accepté (acteur user:invité) :
# OPENPLAN_API_TOKEN=
# Délai d'attente d'une réponse (s). Un modèle local de 7 B sur processeur peut dépasser 5 min.
# OPENPLAN_AI_TIMEOUT_S=600
